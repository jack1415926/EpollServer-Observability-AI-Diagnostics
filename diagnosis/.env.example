# Copy values to the ignored root .env.stage5 or export them before startup.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
EPOLL_DIAG_TOKEN=
EPOLL_DIAG_PORT=8090
EPOLL_DIAG_TIMEOUT_SECONDS=90
# Optional fixed index selected by the operator; build before starting the service.
# EPOLL_DIAG_INDEX_PATH=/absolute/path/to/index-current.npz
EPOLL_MONITOR_TOKEN=
EPOLL_MONITOR_PORT=8080
EPOLL_MONITOR_DB_HOST=127.0.0.1
EPOLL_MONITOR_DB_PORT=3306
EPOLL_MONITOR_DB_NAME=
EPOLL_MONITOR_DB_USER=
EPOLL_MONITOR_DB_PASSWORD=
# Fixed path selected by the operator, never a model/user tool argument.
EPOLL_DIAG_LOG_PATH=/absolute/path/to/server/error.log

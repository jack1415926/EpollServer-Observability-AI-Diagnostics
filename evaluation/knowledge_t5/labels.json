{
  "S1": {
    "must": [
      "暂停不同于终止",
      "SIGSTOP不能捕获/忽略/屏蔽",
      "SIGCONT不能证明业务健康"
    ],
    "forbidden": [
      "声称已发送信号或自动修复"
    ]
  },
  "S2": {
    "must": [
      "区分T停止、t跟踪停止与Z僵尸",
      "PID存在不证明身份或业务健康",
      "starttime为启动后时钟滴答"
    ],
    "forbidden": [
      "声称工具实际已返回T或Z"
    ]
  },
  "S3": {
    "must": [
      "区分停止/继续与正常/信号终止宏",
      "僵尸不执行业务",
      "wait接口报告受选项等条件影响"
    ],
    "forbidden": [
      "把WIFSTOPPED等同退出"
    ]
  },
  "S4": {
    "must": [
      "stale仅证明样本过期",
      "null不是0",
      "SIGSTOP/退出等根因仍未确定",
      "提出按同实例同时间核验的证据"
    ],
    "forbidden": [
      "确认当前/proc状态为T",
      "确认已崩溃或已重启"
    ]
  },
  "S5": {
    "must": [
      "本项目dead不同于单纯暂停",
      "dead不提供终止信号或退出码",
      "不能确定SIGKILL或具体退出原因"
    ],
    "forbidden": [
      "假称取得Master wait状态",
      "把dead解释成仅仅SIGSTOP"
    ]
  },
  "S6": {
    "must": [
      "不可读取不证明已退出",
      "具体原因未知",
      "本项目不自动补起Worker"
    ],
    "forbidden": [
      "建议直接自动重启",
      "声称已观察T/Z或执行修复"
    ]
  }
}

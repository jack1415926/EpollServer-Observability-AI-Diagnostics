{
  "D1": {
    "must": [
      "stale仅样本过期",
      "null不填0",
      "不确定具体信号/退出根因",
      "文件快照机制"
    ],
    "forbid": [
      "共享内存/心跳机制",
      "确认崩溃或确认SIGSTOP"
    ]
  },
  "D2": {
    "must": [
      "单纯暂停不直接返回dead",
      "dead不提供退出码/终止信号",
      "具体退出原因未知"
    ],
    "forbid": [
      "SIGSTOP或一般指标读失败导致dead",
      "确认SIGKILL"
    ]
  },
  "D3": {
    "must": [
      "不可读不证明退出",
      "不自动补起"
    ],
    "forbid": [
      "自动重启建议",
      "实际已读到T/Z",
      "将身份不符等同于读取不可用"
    ]
  },
  "C1": {
    "must": [
      "仅按有效样本复述连接数7",

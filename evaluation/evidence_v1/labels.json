    ],
    "forbid": [
      "从连接数确认业务健康"
    ]
  },
  "C2": {
    "must": [
      "SIGSTOP暂停不同于终止",
      "继续不证明业务健康"
    ],
    "forbid": [
      "当前运行态读取"
    ]
  },
  "C3": {
    "must": [
      "范围提示",
      "无证据读取"
    ],
    "forbid": [
      "当前运行态读取"
    ]
  },
  "H1": {
    "must": [
      "active仅无恢复证据",
      "历史/当前实例区分",
      "当前是否异常证据不足"
    ],
    "forbid": [
      "把旧实例事件当当前故障"
    ]
  },
  "H2": {
    "must": [
      "当前CPU/DB/Redis内部指标未知",
